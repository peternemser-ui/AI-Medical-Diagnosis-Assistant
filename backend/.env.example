# ══════════════════════════════════════════════════════════════════
# AI Medical Diagnosis Assistant — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ══════════════════════════════════════════════════════════════════

# ── AI Provider Keys ──────────────────────────────────────────────

# Required: Anthropic API key for the multi-agent Claude pipeline
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: OpenAI fallback (GPT-4o)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Google Gemini API key
GOOGLE_API_KEY=AIza-your-google-key-here

# ── Database ──────────────────────────────────────────────────────

# Optional: PostgreSQL connection string (production).
# If not set, the app falls back to a local SQLite file (medical_auth.db).
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://meddiagnose:yourpassword@localhost:5432/meddiagnose

# ── Security ──────────────────────────────────────────────────────

# Required in production: 64-byte random secret for signing JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# If not set, a random secret is auto-generated and written to .env on first run
# (tokens become invalid on restart — not suitable for production).
JWT_SECRET=replace-with-a-long-random-string-at-least-64-chars

# Required in production: Fernet symmetric key for encrypting PII at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, a key is auto-generated and written to .env on first run
# (existing encrypted data becomes unreadable if the key changes).
ENCRYPTION_KEY=your-fernet-key-here

# ── SMTP / Email ──────────────────────────────────────────────────

# Optional: SMTP settings for sending verification emails and notifications.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-here
FROM_EMAIL=noreply@meddiagnose.ai

# URL included in email links (password reset, verification, etc.)
FRONTEND_URL=http://localhost:3000

# ── Stripe (Billing) ──────────────────────────────────────────────

# Optional: Stripe secret key for subscription billing
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here

# Optional: Stripe webhook signing secret (from Stripe dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Optional: Stripe Price IDs for each subscription tier
STRIPE_PRICE_PLUS_MONTHLY=price_plus_monthly
STRIPE_PRICE_PLUS_ANNUAL=price_plus_annual
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
STRIPE_PRICE_FAMILY_MONTHLY=price_family_monthly
STRIPE_PRICE_FAMILY_ANNUAL=price_family_annual

# ── CORS ──────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ── HTTPS / Security Headers ──────────────────────────────────────

# Set to "true" in production to add Strict-Transport-Security header.
ENFORCE_HTTPS=false

# ── Ollama (Local LLM — optional) ────────────────────────────────

# Base URL for a locally-running Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434

# Timeout in seconds for Ollama requests.
OLLAMA_TIMEOUT=180.0

# ── Agent Timeouts ────────────────────────────────────────────────

# Timeout in seconds for cloud AI agent calls (Anthropic / OpenAI / Google).
AGENT_TIMEOUT=180.0

# Timeout in seconds for Ollama-backed agent calls.
AGENT_TIMEOUT_OLLAMA=180.0

# Timeout for heavy agents (Specialist, Treatment) that use larger context.
AGENT_TIMEOUT_HEAVY=240.0

# ── Error Monitoring (Sentry) ─────────────────────────────────────

# Optional: Sentry DSN for error tracking. Leave blank to disable Sentry.
# Get your DSN at https://sentry.io
SENTRY_DSN=
